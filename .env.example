APP_NAME="King Builders Business OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8087

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (Docker service name) ---------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=king_builders
DB_USERNAME=king_builders
DB_PASSWORD=secret

# --- Session / Cache / Queue (backed by Redis) ---------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=king_builders

# --- Redis (Docker service name) ---------------------------------------
# Required — the redis service now always runs with --requirepass, so this
# must be non-empty (any local value is fine; docker-compose.yml enforces it).
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kingbuilders.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Host port mapping (change only if a port is already taken locally) --
# Deliberately uncommon ports so the stack comes up cleanly alongside other
# local Docker/Laravel projects (which usually grab 8080 / 3306-3307 / 6379).
APP_HTTP_PORT=8087
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=16379
VITE_HOST_PORT=5173

# --- Vite dev server (run `docker compose --profile dev up vite`) --------
VITE_APP_NAME="${APP_NAME}"
VITE_DEV_SERVER_URL=http://localhost:5173

# --- Project / tenant branding (see App\Support\Branding) ---------------
BRAND_NAME="King Builders"
BRAND_PRIMARY="#2563eb"
BRAND_PRIMARY_FG="#ffffff"
BRAND_ACCENT="#0ea5e9"
BRAND_LOGO_PATH=

# Payment-collection QR code (e.g. a static UPI QR) printed on receipts.
BRAND_QR_PATH=

# Authorised-signatory stamp + handwritten signature printed above
# "(AUTHORISED SIGNATORY)".
BRAND_STAMP_PATH=
BRAND_SIGNATURE_PATH=

# Faint background watermark printed behind the receipt content.
BRAND_WATERMARK_PATH=

# Letterhead contact details for printed documents (receipts, etc.). Blank by
# default — the fields are simply omitted from the document until set.
BRAND_EMAIL=
BRAND_PHONE=
BRAND_WEBSITE=
BRAND_HEAD_OFFICE_ADDRESS=

# Official bank account to print on receipts. Leave unset until confirmed —
# the receipt only prints the "deposit only into this account" notice once
# BRAND_BANK_ACCOUNT_NUMBER is set.
BRAND_BANK_NAME=
BRAND_BANK_ACCOUNT_NAME=
BRAND_BANK_ACCOUNT_NUMBER=
BRAND_BANK_IFSC=
BRAND_BANK_BRANCH=
