###############################################################################
# King Builders Business OS — PRODUCTION environment template (M12)
#
# Copy to `.env` on the production host and fill in every value marked CHANGE-ME.
# NEVER commit the real file (.env is git-ignored).
#
#   1. cp .env.production.example .env
#   2. edit the CHANGE-ME values
#   3. docker compose -f docker-compose.yml -f docker-compose.prod.yml run --rm app php artisan key:generate --force
#   4. see docs/DEPLOYMENT.md
###############################################################################

APP_NAME="King Builders Business OS"
APP_ENV=production
APP_KEY=                                   # CHANGE-ME  → php artisan key:generate --force
APP_DEBUG=false
APP_URL=https://erp.example.com            # CHANGE-ME  → the real HTTPS URL

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Super-admin bootstrap (ONE TIME — see docs/DEPLOYMENT.md) ---------------
# `php artisan db:seed` ABORTS in production unless this is set (min 12 chars);
# it never creates the account with a known default. Set it only for the seed
# run, then remove it from the environment.
SEED_SUPERADMIN_PASSWORD=                   # CHANGE-ME → long random string, then unset after seeding
# SEED_SUPERADMIN_EMAIL=admin@erp.example.com
# SEED_SUPERADMIN_NAME="Platform Admin"

# --- Logging -----------------------------------------------------------------
# Daily rotating file, warnings and above only. Point LOG_STACK at `stderr`
# instead if you ship container logs to a collector.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# --- Database --------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=king_builders
DB_USERNAME=king_builders
DB_PASSWORD=                               # CHANGE-ME  → long random string
# MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt   # if DB is remote / TLS

# Consumed by the mysql container in docker-compose.prod.yml:
DB_ROOT_PASSWORD=                          # CHANGE-ME  → long random string

# --- Session / Cache / Queue (Redis) --------------------------------------
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=erp.example.com             # CHANGE-ME  (no scheme, no port)

CACHE_STORE=redis
CACHE_PREFIX=king_builders
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=                            # CHANGE-ME  → long random string
REDIS_PORT=6379

# --- Reverse proxy / TLS termination -------------------------------------
# `*` trusts every forwarded header — safe because the app container exposes
# no port and is only reachable through the nginx container. Narrow to the
# proxy/LB CIDR if the app is on a shared network.
TRUSTED_PROXIES=*

# --- Security headers (App\Http\Middleware\SecurityHeaders) --------------
SECURITY_HEADERS_ENABLED=true
# SECURITY_HEADERS_CSP=                    # set to override the built-in CSP; "off" disables CSP only
SECURITY_HSTS="max-age=31536000; includeSubDomains"

# --- Mail (transactional — password reset etc.) -------------------------
MAIL_MAILER=smtp                          # CHANGE-ME if you send real mail
MAIL_HOST=                                 # CHANGE-ME
MAIL_PORT=587
MAIL_USERNAME=                             # CHANGE-ME
MAIL_PASSWORD=                             # CHANGE-ME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@example.com"   # CHANGE-ME
MAIL_FROM_NAME="${APP_NAME}"

# --- Uploads -------------------------------------------------------------
DOCUMENT_MAX_KB=15360                      # 15 MB per M9 document

# --- Object storage (optional — only if moving documents off local disk) --
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Branding ----------------------------------------------------------------
BRAND_NAME="King Builders"
BRAND_PRIMARY="#2563eb"
BRAND_PRIMARY_FG="#ffffff"
BRAND_ACCENT="#0ea5e9"
BRAND_LOGO_PATH=

# --- Backups (docker/backup/backup.sh) ---------------------------------------
BACKUP_DIR=/opt/king-builders/backups
BACKUP_RETENTION_DAYS=14
# BACKUP_GPG_RECIPIENT=ops@example.com     # encrypt backups at rest (recommended)
# BACKUP_S3_BUCKET=s3://my-offsite-bucket/king-builders   # off-site copy

# --- Container image tag (set by the deploy script) -----------------------
APP_IMAGE_TAG=latest
WWWUID=1000
WWWGID=1000
